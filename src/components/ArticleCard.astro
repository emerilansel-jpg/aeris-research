---
// ArticleCard.astro — Platform-style research card
interface Props {
  title: string;
  slug: string;
  category: string;
  description: string;
  author: string;
  date: Date;
  featured_image?: string;
}

const { title, slug, category, description, author, date, featured_image } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(date);

const authorDisplay = author.split(',')[0].trim();
---

<article class="article-card">
  {featured_image ? (
    <img
      class="article-card__thumb"
      src={featured_image}
      alt={title}
      loading="lazy"
      width="600"
      height="338"
    />
  ) : (
    <div class="article-card__thumb-placeholder" aria-hidden="true">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#c4c4d0" stroke-width="1.5">
        <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/>
        <polyline points="13 2 13 9 20 9"/>
      </svg>
    </div>
  )}

  <div class="article-card__body">
    <span class="article-card__tag">{category}</span>

    <h2 class="article-card__title">
      <a href={`/research/${slug}`}>{title}</a>
    </h2>

    <p class="article-card__excerpt">{description}</p>

    <div class="article-card__footer">
      <span class="article-card__author">{authorDisplay}</span>
      <time class="article-card__date" datetime={date.toISOString()}>{formattedDate}</time>
    </div>
  </div>
</article>
