---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Aeris Research"
  description="The page you are looking for could not be found."
  noindex={true}
>
  <section class="section" style="padding: 80px 0; text-align: center;">
    <div class="container">
      <h1 style="font-size: 2.5rem; margin-bottom: 16px;">Page Not Found</h1>
      <p style="color: var(--muted); margin-bottom: 32px;">
        The page you are looking for does not exist or has been moved.
      </p>
      <a href="/" class="btn btn--violet">Back to Home</a>
    </div>
  </section>
</BaseLayout>
