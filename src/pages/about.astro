---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About Aeris Research — Independent Technology Intelligence" description="Aeris Research is an independent technology intelligence firm founded in 2013, covering AI, cloud, cybersecurity, SaaS, and fintech for enterprise buyers and institutional investors.">
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <p class="section__eyebrow">About Us</p>
        <h1 class="page-hero__title">About Aeris Research</h1>
        <p class="page-hero__sub">Independent technology intelligence for decision-makers who need the unfiltered truth on the technology landscape.</p>
      </div>
    </div>
  </div>
  <div class="about-page">
    <div class="about-section">
      <h2 class="about-section__title">Our Mission</h2>
      <div class="about-section__body">
        <p>Aeris Research was founded in 2013 with a single mission: to provide technology buyers, investors, and strategists with genuinely independent intelligence — free from vendor sponsorships, paid placements, and the conflicts that compromise most technology analyst firms.</p>
        <p>We believe the technology industry deserves research that reflects reality, not vendor marketing. That means hands-on product testing, structured practitioner panels, and transparent scoring frameworks that clients can interrogate and trust.</p>
      </div>
    </div>
    <div class="about-section">
      <h2 class="about-section__title">Coverage Areas</h2>
      <div class="about-section__body">
        <div class="verticals-grid">
          <div class="vertical-item">Artificial Intelligence & ML</div>
          <div class="vertical-item">Cybersecurity</div>
          <div class="vertical-item">Cloud & Infrastructure</div>
          <div class="vertical-item">SaaS & Enterprise Software</div>
          <div class="vertical-item">Fintech & Digital Payments</div>
          <div class="vertical-item">Data & Analytics</div>
          <div class="vertical-item">Developer Tools & DevOps</div>
          <div class="vertical-item">Digital Transformation</div>
        </div>
      </div>
    </div>
    <div class="about-section">
      <h2 class="about-section__title">Our Offices</h2>
      <div class="about-section__body">
        <p>Aeris Research operates from four research hubs: San Francisco (headquarters), London, Singapore, and Berlin — providing coverage across North American, European, and Asia-Pacific technology markets.</p>
      </div>
    </div>
  </div>
</BaseLayout>
