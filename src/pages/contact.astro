---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Aeris Research — Request a Research Brief" description="Contact Aeris Research to commission independent technology intelligence, request a research brief, or discuss a custom research engagement.">
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <p class="section__eyebrow">Get in Touch</p>
        <h1 class="page-hero__title">Contact Us</h1>
        <p class="page-hero__sub">Commission a research brief, discuss a custom engagement, or request sample reports. Our team responds within one business day.</p>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container" style="max-width: 760px;">
      <p style="font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 2rem;">Use the form below or email us directly at <a href="mailto:research@aerisresearch.com" style="color: var(--teal);">research@aerisresearch.com</a>.</p>
      <form style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">First Name</label><input type="text" placeholder="Jane" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
          <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Last Name</label><input type="text" placeholder="Smith" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        </div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Work Email *</label><input type="email" required placeholder="jane@company.com" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Organisation</label><input type="text" placeholder="Company name" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Research Interest</label><select style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;"><option>Artificial Intelligence</option><option>Cybersecurity</option><option>Cloud & Infrastructure</option><option>SaaS & Enterprise Software</option><option>Fintech</option><option>Custom Research</option><option>Due Diligence</option><option>Advisory Retainer</option></select></div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Message</label><textarea rows="5" placeholder="Describe your research needs…" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;resize:vertical;"></textarea></div>
        <button type="submit" class="btn btn--teal" style="width:fit-content;">Send Message →</button>
      </form>
    </div>
  </section>
</BaseLayout>
