---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Aeris Research — Request a Research Brief" description="Contact Aeris Research to commission independent technology intelligence, request a research brief, or discuss a custom research engagement.">
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <p class="section__eyebrow">Get in Touch</p>
        <h1 class="page-hero__title">Contact Us</h1>
        <p class="page-hero__sub">Commission a research brief, discuss a custom engagement, or request sample reports. Our team responds within one business day.</p>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container" style="max-width: 760px;">
      <p style="font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 2rem;">Use the form below or email us directly at <a href="mailto:research@aerisresearch.com" style="color: var(--teal);">research@aerisresearch.com</a>.</p>
      <form id="contact-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="position: absolute; left: -5000px;" aria-hidden="true">
          <label for="website-hp">Website</label>
          <input type="text" id="website-hp" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">First Name</label><input type="text" name="first_name" placeholder="Jane" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
          <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Last Name</label><input type="text" name="last_name" placeholder="Smith" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        </div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Work Email *</label><input type="email" name="email" required placeholder="jane@company.com" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Organisation</label><input type="text" name="organisation" placeholder="Company name" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Research Interest</label><select name="interest" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;"><option>Artificial Intelligence</option><option>Cybersecurity</option><option>Cloud & Infrastructure</option><option>SaaS & Enterprise Software</option><option>Fintech</option><option>Custom Research</option><option>Due Diligence</option><option>Advisory Retainer</option></select></div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Message</label><textarea name="message" rows="5" placeholder="Describe your research needs…" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;resize:vertical;"></textarea></div>
        <button type="submit" class="btn btn--teal" style="width:fit-content;">Send Message →</button>
      </form>
      <script is:inline>
        (function () {
          var form = document.getElementById('contact-form');
          if (!form) return;
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var honeypot = form.querySelector('input[name="website"]');
            if (honeypot && honeypot.value) {
              console.warn('Honeypot filled. Submission blocked.');
              return;
            }
            var firstName = (form.querySelector('input[name="first_name"]')?.value || '').trim();
            var lastName = (form.querySelector('input[name="last_name"]')?.value || '').trim();
            var email = (form.querySelector('input[name="email"]')?.value || '').trim();
            var org = (form.querySelector('input[name="organisation"]')?.value || '').trim();
            var interest = (form.querySelector('select[name="interest"]')?.value || '').trim();
            var message = (form.querySelector('textarea[name="message"]')?.value || '').trim();
            var subject = 'Inquiry from Aeris Research website';
            var body = 'Name: ' + firstName + ' ' + lastName + '\n' +
                       'Email: ' + email + '\n' +
                       'Organisation: ' + org + '\n' +
                       'Research Interest: ' + interest + '\n' +
                       'Message:\n' + message;
            window.location.href = 'mailto:research@aerisresearch.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
          });
        })();
      </script>
    </div>
  </section>
</BaseLayout>
