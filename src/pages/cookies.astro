---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Cookie Policy — Aeris Research" noindex={true}>
  <div class="page-hero"><div class="container"><div class="page-hero__content"><h1 class="page-hero__title">Cookie Policy</h1></div></div></div>
  <div class="about-page">
    <div class="about-section"><h2 class="about-section__title">Cookies We Use</h2><div class="about-section__body"><p>Aeris Research uses strictly necessary cookies (session management, security) and optional analytics cookies (understanding how visitors use our site). We do not use advertising or tracking cookies. You may disable analytics cookies without affecting site functionality.</p></div></div>
    <div class="about-section"><h2 class="about-section__title">Managing Cookies</h2><div class="about-section__body"><p>You can manage cookie preferences through your browser settings. For questions about our cookie use, contact <a href="mailto:privacy@aerisresearch.com" style="color:var(--teal);">privacy@aerisresearch.com</a>.</p></div></div>
  </div>
</BaseLayout>
