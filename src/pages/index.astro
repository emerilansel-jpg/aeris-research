const whyPoints = [
  { title: 'Genuinely Vendor-Neutral', desc: 'No vendor sponsorship, no paid placement, no consulting relationships with the companies we cover. Our scores are ours alone.' },
  { title: 'Hands-On Product Testing', desc: 'Every product we rate has been tested by our analysts in real enterprise scenarios — not just briefed by vendor marketing teams.' },
  { title: 'Transparent Scoring', desc: 'Our 40+ dimension scoring framework is fully documented. Clients see every score, weight, and assumption behind our ratings.' },
  { title: 'Longitudinal Coverage', desc: 'We track vendors over multi-year cycles — so our assessments reflect actual execution, not just announced roadmaps.' },
