  { cat: 'Cybersecurity', title: 'Zero Trust Is Not a Product: A Framework for Architecture-First Security', date: 'May 2026', slug: 'zero-trust-architecture-first' },
  { cat: 'Cloud', title: 'FinOps 3.0: How AI Is Transforming Cloud Cost Management', date: 'April 2026', slug: 'finops-ai-cloud-cost' },
  { cat: 'SaaS', title: 'The Vertical SaaS Inflection Point: Industry-Specific vs. Horizontal Scale', date: 'April 2026', slug: 'vertical-saas-inflection' },
