  {
    num: '02',
    title: 'Proprietary Scoring Framework',
    desc: 'Our analysts score each vendor across 40+ dimensions — from technical capability and roadmap credibility to pricing transparency and support quality.',
  },
  {
    num: '03',
    title: 'Expert Review & Calibration',
    desc: 'Every report undergoes structured peer review by a senior analyst and calibration against our longitudinal vendor performance database before publication.',
  },
  {
    num: '04',
    title: 'Decision-Ready Delivery',
    desc: 'Intelligence is distilled into concise, action-oriented formats — from rapid vendor snapshots to full strategic reports with scenario modelling.',
  },
];

const testimonials = [
  {
    quote: 'Aeris delivered the most thorough competitive intelligence I have seen in 20 years of technology procurement. Their vendor scoring framework is genuinely differentiated.',
    name: 'Chief Information Officer',
    firm: 'Fortune 500 Financial Services Firm',
  },
  {
    quote: 'The technical due diligence Aeris provided on our Series B target was exceptional. They surfaced architectural risks our engineers had missed and gave us the confidence to proceed.',
    name: 'Partner, Technology Practice',
    firm: 'Leading Growth Equity Firm',
  },
  {
