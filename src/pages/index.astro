];

const publications = [
  { name: 'TechCrunch', quote: 'Aeris Research\'s vendor evaluations have become essential reading for enterprise technology procurement teams navigating an increasingly crowded AI landscape.' },
  { name: 'The Information', quote: 'The firm\'s independent stance on AI platform comparisons fills a critical gap left by analyst firms with vendor relationships to protect.' },
  { name: 'MIT Technology Review', quote: 'Aeris brings a level of methodological rigor to technology market analysis that is rarely seen outside of academic research.' },
