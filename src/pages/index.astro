---
// index.astro — Aeris Research homepage
// Design: Modern tech intelligence platform (The Information meets Product Hunt)
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('research');
const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3);

const signalItems = [
  'Anthropic Claude 4 signals next wave of enterprise AI deployment',
  'AWS re:Invent 2026: serverless GPU reshapes ML inference economics',
  'CrowdStrike and Microsoft settle landmark breach liability dispute',
  'Open-source LLM gap narrows — Llama 4 scores within 3% of GPT-4o',
  'Fintech consolidation accelerates as interest margins compress globally',
  'Kubernetes 2.0 spec finalized — platform engineering teams respond',
  'Databricks acquires MosaicML in $1.3B talent-plus-IP deal',
  'Zero-trust mandates now apply to 78% of Fortune 500 technology stacks',
];

const categories = [
  { label: 'All', href: '/research', active: true },
  { label: 'AI & ML', href: '/research?cat=ai' },
  { label: 'Cybersecurity', href: '/research?cat=cybersecurity' },
  { label: 'Cloud', href: '/research?cat=cloud' },
  { label: 'SaaS', href: '/research?cat=saas' },
  { label: 'Fintech', href: '/research?cat=fintech' },
  { label: 'Data', href: '/research?cat=data' },
  { label: 'DevOps', href: '/research?cat=devops' },
];

const latestSmall = [
  {
    tag: 'Cybersecurity',
    title: 'Zero Trust Is Not a Product: Architecture-First Security in 2026',
    date: 'Jun 2, 2026',
    img: '/images/card-cyber.png',
    href: '/research/zero-trust-architecture',
  },
  {
    tag: 'Cloud',
    title: 'FinOps 3.0: How AI Is Automating Cloud Cost Optimization',
    date: 'May 28, 2026',
    img: '/images/card-cloud.png',
    href: '/research/finops-ai-cloud-cost',
  },
  {
    tag: 'SaaS',
    title: 'Vertical SaaS at the Inflection Point: Where the Next $100B Companies Are Built',
    date: 'May 22, 2026',
    img: '/images/card-saas.png',
    href: '/research/vertical-saas-inflection',
  },
];

const sectors = [
  { icon: '🤖', label: 'Artificial Intelligence', count: 94, href: '/research?cat=ai' },
  { icon: '🔐', label: 'Cybersecurity', count: 78, href: '/research?cat=cybersecurity' },
  { icon: '☁️', label: 'Cloud & Infrastructure', count: 62, href: '/research?cat=cloud' },
  { icon: '📦', label: 'SaaS & Enterprise', count: 88, href: '/research?cat=saas' },
  { icon: '💳', label: 'Fintech', count: 55, href: '/research?cat=fintech' },
  { icon: '📊', label: 'Data & Analytics', count: 49, href: '/research?cat=data' },
  { icon: '⚙️', label: 'Developer Tools', count: 41, href: '/research?cat=devops' },
  { icon: '🔄', label: 'Digital Transformation', count: 67, href: '/research?cat=digital' },
];

const stats = [
  { num: '450+', label: 'Reports Published' },
  { num: '62', label: 'Technology Sectors Covered' },
  { num: '200+', label: 'Enterprise Clients' },
  { num: '1,800+', label: 'Vendor Evaluations' },
];

const whyPoints = [
  {
    title: 'Zero vendor sponsorships',
    desc: 'No paid placements, no vendor briefings that influence scores. Every rating is earned, not purchased.',
  },
  {
    title: 'Hands-on product testing',
    desc: 'Every tool we rate has been tested by our analysts in real enterprise production environments.',
  },
  {
    title: 'Transparent scoring framework',
    desc: 'Our 40+ dimension methodology is fully documented. Clients see every weight and assumption.',
  },
  {
    title: 'Longitudinal vendor tracking',
    desc: 'We track vendors over multi-year cycles — our assessments reflect actual execution, not just roadmaps.',
  },
  {
    title: 'Practitioner validation network',
    desc: '300+ active CIOs, CTOs, and security leaders validate our findings through structured panels.',
  },
];

const analysts = [
  {
    name: 'Priya Nair',
    role: 'Head of AI Research',
    bio: '14 years covering enterprise AI, MLOps, and foundation model ecosystems. PhD Computer Science, MIT.',
    photo: '/images/analyst-1.png',
  },
  {
    name: 'Marcus Osei',
    role: 'Director, Cybersecurity',
    bio: 'Former CISO. Deep expertise in zero-trust architecture, cloud security platform dynamics.',
    photo: '/images/analyst-2.png',
  },
  {
    name: 'Sofia Lindqvist',
    role: 'Senior Analyst, Cloud & SaaS',
    bio: 'Specialist in multi-cloud strategy, FinOps economics, and vertical SaaS market development.',
    photo: '/images/analyst-3.png',
  },
  {
    name: 'David Chen',
    role: 'Analyst, Fintech & Data',
    bio: 'Covers embedded finance, real-time payments, modern data stack economics, and analytics tooling.',
    photo: '/images/analyst-4.png',
  },
  {
    name: 'Amara Okafor',
    role: 'Analyst, Developer Tools',
    bio: 'Platform engineering specialist, AI-assisted coding tools, DevSecOps, and supply chain security.',
    photo: '/images/analyst-5.png',
  },
];

const insights = [
  { tag: 'AI', title: 'The Hidden Cost of Enterprise AI: Why 64% of Deployments Underperform', date: 'Jun 2026', href: '/insights/enterprise-ai-hidden-costs' },
  { tag: 'Cybersecurity', title: 'Zero Trust Is Not a Product: A Framework for Architecture-First Security', date: 'May 2026', href: '/insights/zero-trust-framework' },
  { tag: 'Cloud', title: 'FinOps 3.0: How AI Is Transforming Cloud Cost Management at Scale', date: 'May 2026', href: '/insights/finops-ai-cloud' },
  { tag: 'SaaS', title: 'The Vertical SaaS Inflection Point: Industry-Specific vs. Horizontal Scale', date: 'Apr 2026', href: '/insights/vertical-saas' },
  { tag: 'Fintech', title: 'Embedded Finance at Scale: The Middleware Layer Nobody Is Talking About', date: 'Mar 2026', href: '/insights/embedded-finance' },
  { tag: 'Data', title: 'Lakehouse vs. Warehouse: The 2026 Verdict on the Modern Data Stack', date: 'Mar 2026', href: '/insights/lakehouse-2026' },
];

const newsletterItems = [
  'Why OpenAI\'s pricing shift signals a new enterprise AI era',
  'CrowdStrike Q1 2026 earnings: key analyst takeaways',
  'Databricks vs. Snowflake: the real battle is now in real-time',
  'Three cybersecurity vendors to watch in H2 2026',
];
---

<BaseLayout
  title="Aeris Research — Independent Tech Intelligence Platform"
  description="Aeris is the tech intelligence platform for enterprise decision-makers, investors, and operators. Vendor-neutral analysis across AI, cloud, cybersecurity, SaaS, and fintech."
  pageType="homepage"
>

  <!-- ═══════════════════════════════════════════════
       HERO — Editorial split
  ════════════════════════════════════════════════ -->
  <section class="hero--platform" aria-label="Hero">
    <div class="container">
      <div class="hero__split">

        <!-- Left: Headline + filters + CTAs -->
        <div class="hero__left">
          <div class="hero__kicker">
            <span class="hero__kicker-dot"></span>
            Independent · Vendor-Neutral · Hands-On
          </div>

          <h1 class="hero__headline">
            The intelligence layer for <span>tech decisions</span>
          </h1>

          <p class="hero__sub">
            Aeris delivers analyst-grade technology research without the conflicts. AI, cloud, cybersecurity, SaaS, fintech — scored against real criteria, tested in real environments.
          </p>

          <div class="hero__filters" role="group" aria-label="Category filters">
            {categories.map(cat => (
              <a
                href={cat.href}
                class={`hero__filter-pill${cat.active ? ' hero__filter-pill--active' : ''}`}
              >
                {cat.label}
              </a>
            ))}
          </div>

          <div class="hero__actions">
            <a href="/research" class="btn btn--violet btn--lg">Explore Reports</a>
            <a href="/contact" class="btn btn--outline btn--lg">Request Brief</a>
          </div>
        </div>

        <!-- Right: Featured article card -->
        <div class="hero__right">
          <a href="/research/enterprise-ai-deployment-2026" class="hero__featured-card">
            <img
              class="hero__featured-img"
              src="/images/hero-featured.png"
              alt="Enterprise AI Deployment Index 2026"
              width="800"
              height="500"
            />
            <div class="hero__featured-body">
              <div class="hero__featured-tag">Featured Report</div>
              <div class="hero__featured-title">
                Enterprise AI Deployment Index 2026: Adoption, ROI &amp; Risk
              </div>
              <div class="hero__featured-meta">
                <span>Priya Nair</span>
                <span>·</span>
                <span>86 pages</span>
                <span>·</span>
                <span>June 2026</span>
              </div>
              <div class="hero__featured-read">
                Read the report
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       SIGNAL BAR — Terminal scrolling ticker
  ════════════════════════════════════════════════ -->
  <div class="signal-bar" aria-label="Live intelligence signals" role="marquee" aria-live="off">
    <span class="signal-bar__label" aria-hidden="true">SIGNAL</span>
    <div class="signal-bar__track">
      {signalItems.map(item => (<span class="signal-bar__item">{item}</span>))}
      {signalItems.map(item => (<span class="signal-bar__item">{item}</span>))}
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════
       LATEST INTELLIGENCE — 2-col editorial grid
  ════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="intel-title">
    <div class="container">
      <div class="section__header" style="margin-bottom: 28px; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;">
        <div>
          <span class="section__label">Latest Intelligence</span>
          <h2 class="section__title" id="intel-title">Fresh from the platform</h2>
        </div>
        <a href="/research" class="btn btn--ghost">
          All reports
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="intel-grid">
        <!-- Left: big hero article -->
        <a href="/research/ai-hidden-costs-2026" class="intel-hero">
          <img
            class="intel-hero__img"
            src="/images/intel-hero.png"
            alt="AI Hidden Costs"
            width="800"
            height="500"
            loading="lazy"
          />
          <div class="intel-hero__body">
            <span class="intel-hero__tag">Artificial Intelligence</span>
            <div class="intel-hero__title">
              The Hidden Cost of Enterprise AI: Why 64% of Deployments Underperform Forecasts
            </div>
            <p class="intel-hero__excerpt">
              Our 2026 benchmarking study across 340 enterprise AI deployments reveals a consistent pattern of post-deployment performance gaps driven by infrastructure underestimation, data quality debt, and misaligned procurement assumptions.
            </p>
            <div class="intel-hero__meta">Priya Nair · June 2026 · 12 min read</div>
          </div>
        </a>

        <!-- Right: stack of 3 -->
        <div class="intel-stack">
          {latestSmall.map(item => (
            <a href={item.href} class="intel-item">
              <img
                class="intel-item__img"
                src={item.img}
                alt={item.title}
                width="88"
                height="64"
                loading="lazy"
              />
              <div class="intel-item__body">
                <span class="intel-item__tag">{item.tag}</span>
                <div class="intel-item__title">{item.title}</div>
                <div class="intel-item__meta">{item.date}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       TOPIC SECTORS — Horizontal pill selector
  ════════════════════════════════════════════════ -->
  <section class="section section--soft" aria-labelledby="sectors-title">
    <div class="container">
      <div class="section__header" style="margin-bottom: 28px;">
        <span class="section__label">Coverage Areas</span>
        <h2 class="section__title" id="sectors-title">8 technology sectors, zero conflicts</h2>
        <p class="section__subtitle">Each sector has dedicated analysts, a proprietary vendor database, and 5+ years of longitudinal tracking.</p>
      </div>

      <!-- Pills -->
      <nav class="sectors-tabs" aria-label="Technology sectors">
        {sectors.map((s, i) => (
          <a href={s.href} class={`sector-tab${i === 0 ? ' sector-tab--active' : ''}`}>
            {s.icon} {s.label}
            <span class="sector-tab__count">{s.count}</span>
          </a>
        ))}
      </nav>

      <!-- Report cards grid -->
      <div class="sectors-content">
        <a href="/research?cat=ai" class="sector-report">
          <div class="sector-report__icon">🤖</div>
          <div class="sector-report__title">Enterprise AI Deployment Index 2026</div>
          <div class="sector-report__count">94 reports in AI & ML</div>
        </a>
        <a href="/research?cat=ai" class="sector-report">
          <div class="sector-report__icon">⚡</div>
          <div class="sector-report__title">Foundation Model Comparison: GPT-4o vs. Claude 4 vs. Gemini 2.0</div>
          <div class="sector-report__count">86 pages · June 2026</div>
        </a>
        <a href="/research?cat=ai" class="sector-report">
          <div class="sector-report__icon">🧠</div>
          <div class="sector-report__title">MLOps Platform Vendor Landscape 2026</div>
          <div class="sector-report__count">62 pages · May 2026</div>
        </a>
        <a href="/research?cat=ai" class="sector-report">
          <div class="sector-report__icon">📡</div>
          <div class="sector-report__title">Edge AI: Deployment Economics and Emerging Vendor Stack</div>
          <div class="sector-report__count">44 pages · April 2026</div>
        </a>
        <a href="/research?cat=ai" class="sector-report">
          <div class="sector-report__icon">🔧</div>
          <div class="sector-report__title">AI-Assisted Coding: GitHub Copilot, Cursor, Windsurf Compared</div>
          <div class="sector-report__count">38 pages · April 2026</div>
        </a>
        <a href="/research?cat=ai" class="sector-report">
          <div class="sector-report__icon">🏗️</div>
          <div class="sector-report__title">Agentic AI Infrastructure: The Emerging Orchestration Layer</div>
          <div class="sector-report__count">52 pages · March 2026</div>
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       FEATURED REPORT — Dark spotlight
  ════════════════════════════════════════════════ -->
  <section class="section--report-spotlight" aria-labelledby="spotlight-title">
    <div class="container">
      <div class="report-spotlight">

        <!-- Left: text -->
        <div>
          <div class="report-spotlight__label">Flagship Report</div>
          <h2 class="report-spotlight__title" id="spotlight-title">
            Cybersecurity Platform Consolidation: The 2026 Landscape
          </h2>
          <p class="report-spotlight__desc">
            The security vendor market is converging. Our 72-page analysis maps 140+ vendors across endpoint, cloud, identity, and SIEM categories — scoring consolidation pressure, platform maturity, and the strategic implications for enterprise security buyers navigating a rapidly shrinking field.
          </p>
          <div class="report-spotlight__meta">
            <div class="report-meta-item">
              <span class="report-meta-item__label">Author</span>
              <span class="report-meta-item__value">Marcus Osei</span>
            </div>
            <div class="report-meta-item">
              <span class="report-meta-item__label">Pages</span>
              <span class="report-meta-item__value">72</span>
            </div>
            <div class="report-meta-item">
              <span class="report-meta-item__label">Vendors scored</span>
              <span class="report-meta-item__value">140+</span>
            </div>
            <div class="report-meta-item">
              <span class="report-meta-item__label">Published</span>
              <span class="report-meta-item__value">May 2026</span>
            </div>
          </div>
          <div class="report-spotlight__actions">
            <a href="/research/cybersecurity-consolidation-2026" class="btn btn--violet btn--lg">Download Sample</a>
            <a href="/contact" class="btn btn--outline-white btn--lg">Get Full Access</a>
          </div>
        </div>

        <!-- Right: CSS-generated mockup card -->
        <div class="report-mockup" aria-hidden="true">
          <div class="report-mockup__badge">Aeris Research · 2026</div>
          <div class="report-mockup__title">Cybersecurity Platform Consolidation: The 2026 Landscape</div>
          <div class="report-mockup__divider"></div>
          <div class="report-mockup__stats">
            <div>
              <div class="report-mockup__stat">
                <span class="report-mockup__stat-label">Endpoint Security</span>
                <span class="report-mockup__stat-val">82%</span>
              </div>
              <div class="report-mockup__bar-wrap">
                <div class="report-mockup__bar" style="width: 82%"></div>
              </div>
            </div>
            <div>
              <div class="report-mockup__stat">
                <span class="report-mockup__stat-label">Cloud Security</span>
                <span class="report-mockup__stat-val">71%</span>
              </div>
              <div class="report-mockup__bar-wrap">
                <div class="report-mockup__bar" style="width: 71%"></div>
              </div>
            </div>
            <div>
              <div class="report-mockup__stat">
                <span class="report-mockup__stat-label">Identity & Access</span>
                <span class="report-mockup__stat-val">68%</span>
              </div>
              <div class="report-mockup__bar-wrap">
                <div class="report-mockup__bar" style="width: 68%"></div>
              </div>
            </div>
            <div>
              <div class="report-mockup__stat">
                <span class="report-mockup__stat-label">SIEM / SOAR</span>
                <span class="report-mockup__stat-val">55%</span>
              </div>
              <div class="report-mockup__bar-wrap">
                <div class="report-mockup__bar" style="width: 55%"></div>
              </div>
            </div>
          </div>
          <div class="report-mockup__footer">
            <span class="report-mockup__pages">72 pages · 140+ vendors</span>
            <span class="report-mockup__lock">🔒 Subscriber access</span>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       STATS — 4 big numbers
  ════════════════════════════════════════════════ -->
  <section class="section" aria-label="Platform statistics">
    <div class="container">
      <div class="stats-row">
        {stats.map(stat => (
          <div class="stats-row__item">
            <div class="stats-row__num">{stat.num}</div>
            <div class="stats-row__label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       LATEST RESEARCH (from CMS)
  ════════════════════════════════════════════════ -->
  {posts.length > 0 && (
    <section class="section section--soft" aria-labelledby="cms-posts-title">
      <div class="container">
        <div class="section__header" style="margin-bottom: 28px; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;">
          <div>
            <span class="section__label">From the Platform</span>
            <h2 class="section__title" id="cms-posts-title">Latest published research</h2>
          </div>
          <a href="/research" class="btn btn--ghost">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="article-grid">
          {posts.map(post => (
            <ArticleCard
              title={post.data.title}
              slug={post.slug}
              category={post.data.category}
              description={post.data.description}
              author={post.data.author}
              date={post.data.date}
              featured_image={post.data.featured_image}
            />
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- ═══════════════════════════════════════════════
       WHY INDEPENDENT
  ════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="why-independent">
        <!-- Left: big statement -->
        <div class="why__statement">
          <span class="section__label">Our Principles</span>
          <h2 class="why__statement-quote" id="why-title">
            Research that earns trust by <strong>having nothing to hide</strong>
          </h2>
          <p class="why__statement-sub">
            Most technology analyst firms have vendor relationships that compromise their ratings. We don't. Our independence isn't a marketing claim — it's enforced by structure. No vendor pays us. No placement is for sale.
          </p>
        </div>

        <!-- Right: bullet list -->
        <div class="why__bullets">
          {whyPoints.map((point, i) => (
            <div class="why-bullet">
              <span class="why-bullet__num">0{i + 1}</span>
              <div>
                <div class="why-bullet__title">{point.title}</div>
                <p class="why-bullet__desc">{point.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       ANALYST TEAM — Horizontal strip
  ════════════════════════════════════════════════ -->
  <section class="section section--soft" aria-labelledby="analysts-title">
    <div class="container">
      <div class="section__header" style="margin-bottom: 28px; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;">
        <div>
          <span class="section__label">The Team</span>
          <h2 class="section__title" id="analysts-title">Analysts who've worked in the tech they cover</h2>
        </div>
        <a href="/team" class="btn btn--ghost">
          Meet all analysts
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="analyst-strip-wrap">
        <div class="analyst-strip">
          {analysts.map(analyst => (
            <a href="/team" class="analyst-card">
              <img
                class="analyst-card__photo"
                src={analyst.photo}
                alt={analyst.name}
                width="220"
                height="160"
                loading="lazy"
              />
              <div class="analyst-card__body">
                <div class="analyst-card__name">{analyst.name}</div>
                <div class="analyst-card__role">{analyst.role}</div>
                <p class="analyst-card__bio">{analyst.bio}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       INSIGHTS FEED
  ════════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="insights-title">
    <div class="container">
      <div class="section__header" style="margin-bottom: 28px; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;">
        <div>
          <span class="section__label">Market Commentary</span>
          <h2 class="section__title" id="insights-title">Recent insights</h2>
        </div>
        <a href="/insights" class="btn btn--ghost">
          All insights
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="insights-feed">
        {insights.map(item => (
          <a href={item.href} class="insights-feed__item">
            <span class="insights-feed__tag">{item.tag}</span>
            <span class="insights-feed__title">{item.title}</span>
            <span class="insights-feed__date">{item.date}</span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       PRESS CITATIONS — minimal bar
  ════════════════════════════════════════════════ -->
  <section class="section" aria-label="Featured in" style="padding: 40px 0;">
    <div class="container">
      <div class="press-strip">
        <span class="press-strip__label">As cited in</span>
        <span class="press-strip__item">TechCrunch</span>
        <span class="press-strip__item">The Information</span>
        <span class="press-strip__item">MIT Technology Review</span>
        <span class="press-strip__item">Wall Street Journal</span>
        <span class="press-strip__item">Wired</span>
        <span class="press-strip__item">Ars Technica</span>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       NEWSLETTER — Minimal full-width dark
  ════════════════════════════════════════════════ -->
  <section class="section--newsletter" aria-labelledby="newsletter-title">
    <div class="container">
      <div class="newsletter-platform">

        <!-- Left: pitch + form -->
        <div>
          <h2 class="newsletter__title" id="newsletter-title">
            The <span>Signal</span> — weekly tech intelligence in 5 minutes
          </h2>
          <p class="newsletter__sub">
            Every Friday, our analysts synthesize the week's most significant developments in AI, cloud, cybersecurity, and SaaS. No noise. No sponsored content. Just signal.
          </p>

          <form class="newsletter__form" method="POST" action="/api/newsletter-subscribe" style="margin-top: 28px;">
            <input
              type="email"
              name="email"
              placeholder="your@company.com"
              required
              class="newsletter__input"
              autocomplete="email"
            />
            <button type="submit" class="newsletter__submit">Subscribe free</button>
          </form>

          <div class="newsletter__proof">
            <span class="newsletter__proof-item">6,800+ subscribers</span>
            <span class="newsletter__proof-item">88% open rate</span>
            <span class="newsletter__proof-item">Free forever</span>
            <span class="newsletter__proof-item">Unsubscribe anytime</span>
          </div>
        </div>

        <!-- Right: issue preview -->
        <div class="newsletter__preview">
          <div class="newsletter__preview-header">
            <span class="newsletter__preview-title">The Signal — Issue #124</span>
            <span class="newsletter__preview-date">Jun 6, 2026</span>
          </div>
          <div class="newsletter__preview-items">
            {newsletterItems.map(item => (
              <div class="newsletter__preview-item">
                <div class="newsletter__preview-dot"></div>
                <p class="newsletter__preview-text">{item}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
