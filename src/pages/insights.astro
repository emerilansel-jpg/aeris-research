---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Insights & Commentary — Aeris Research" description="Technology market commentary, analyst perspectives, and rapid intelligence from the Aeris Research team across AI, cloud, cybersecurity, SaaS, and fintech.">
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <p class="section__eyebrow">Market Commentary</p>
        <h1 class="page-hero__title">Insights</h1>
        <p class="page-hero__sub">Analyst perspectives and rapid intelligence on the technology developments shaping enterprise strategy.</p>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <p style="color:var(--text-muted);font-size:1rem;">Insights and commentary will appear here as they are published. <a href="/research" style="color:var(--teal);">View all research reports →</a></p>
    </div>
  </section>
</BaseLayout>
