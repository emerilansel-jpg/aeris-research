---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Technology Vendor Dashboard — Aeris Research" description="Live Aeris Research vendor ratings dashboard — tracking enterprise AI, cloud, cybersecurity, SaaS, and fintech vendor performance in real time.">
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <p class="section__eyebrow">Live Intelligence</p>
        <h1 class="page-hero__title">Vendor Dashboard</h1>
        <p class="page-hero__sub">Real-time vendor ratings and technology market signals from the Aeris Research analyst network.</p>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <p style="color:var(--text-muted);">Live vendor dashboard requires subscriber authentication. <a href="/contact" style="color:var(--teal);">Request access →</a></p>
    </div>
  </section>
</BaseLayout>
