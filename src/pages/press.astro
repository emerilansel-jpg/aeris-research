---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Press & Media — Aeris Research" description="Press resources, media contact information, and recent coverage of Aeris Research in technology media.">
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <p class="section__eyebrow">Press & Media</p>
        <h1 class="page-hero__title">Media Resources</h1>
        <p class="page-hero__sub">For media enquiries, research citations, and press resources. Our communications team responds within four hours.</p>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container" style="max-width:760px;">
      <h2 style="font-family:'DM Serif Display',serif;font-size:1.8rem;color:var(--dark);margin-bottom:1rem;">Media Contact</h2>
      <p style="color:var(--text-secondary);margin-bottom:2rem;">For press enquiries, analyst access for articles, or research citation permissions, contact our communications team at <a href="mailto:press@aerisresearch.com" style="color:var(--teal);">press@aerisresearch.com</a>.</p>
      <h2 style="font-family:'DM Serif Display',serif;font-size:1.8rem;color:var(--dark);margin-bottom:1rem;">Boilerplate</h2>
      <div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:8px;padding:2rem;font-size:0.95rem;color:var(--text-secondary);line-height:1.7;">
        Aeris Research is an independent technology intelligence firm specialising in vendor-neutral research across AI, cloud infrastructure, cybersecurity, enterprise software, and fintech. Founded in 2013 and headquartered in San Francisco, Aeris serves 200+ enterprise clients and 50+ institutional investors across 25 countries. All Aeris research is conducted without vendor sponsorship or financial relationships with covered companies.
      </div>
    </div>
  </section>
</BaseLayout>
