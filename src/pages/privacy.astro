---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy — Aeris Research" noindex={true}>
  <div class="page-hero"><div class="container"><div class="page-hero__content"><h1 class="page-hero__title">Privacy Policy</h1></div></div></div>
  <div class="about-page">
    <div class="about-section"><h2 class="about-section__title">Overview</h2><div class="about-section__body"><p>Aeris Research LLC ("Aeris", "we", "us") is committed to protecting your privacy. This policy describes how we collect, use, and protect personal data when you use aerisresearch.com.</p></div></div>
    <div class="about-section"><h2 class="about-section__title">Data We Collect</h2><div class="about-section__body"><p>We collect information you provide directly (contact forms, newsletter subscriptions, research requests) and technical data collected automatically (IP address, browser type, pages visited) via standard web analytics. We do not sell personal data to third parties.</p></div></div>
    <div class="about-section"><h2 class="about-section__title">Contact</h2><div class="about-section__body"><p>For privacy inquiries: <a href="mailto:privacy@aerisresearch.com" style="color:var(--teal);">privacy@aerisresearch.com</a></p></div></div>
  </div>
</BaseLayout>
