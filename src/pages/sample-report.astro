---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Download Sample Report — Aeris Research" description="Download a sample Aeris Research technology intelligence report to experience our vendor-neutral research quality firsthand.">
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <p class="section__eyebrow">Try Before You Subscribe</p>
        <h1 class="page-hero__title">Sample Report</h1>
        <p class="page-hero__sub">Experience the depth and quality of Aeris Research intelligence before committing to a subscription or engagement.</p>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container" style="max-width:600px;">
      <p style="color:var(--text-secondary);margin-bottom:2rem;">Complete the form below to receive a complimentary copy of our <strong>Enterprise AI Platform Comparison: 2026 Edition</strong> sample report (12 pages).</p>
      <form style="display:flex;flex-direction:column;gap:1rem;">
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Work Email *</label><input type="email" required placeholder="you@company.com" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Company</label><input type="text" placeholder="Company name" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        <div><label style="display:block;font-size:0.8rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Job Title</label><input type="text" placeholder="CTO / CIO / VP Engineering" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-size:0.95rem;" /></div>
        <button type="submit" class="btn btn--teal">Download Sample Report →</button>
      </form>
    </div>
  </section>
</BaseLayout>
